<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Étiquettes — {{ carte.nom }}</title>
    <style>
        @page {
            size: 210mm 297mm;
            margin: 0;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body { margin: 0; padding: 0; }
        body { font-family: Arial, Helvetica, sans-serif; }

        .page {
            width: 210mm;
            height: 297mm;
            display: grid;
            grid-template-columns: 105mm 105mm;
            grid-template-rows: repeat(8, 37mm);
            padding-top: 0.5mm; /* centrage vertical (297 - 8*37 = 1mm / 2) */
            page-break-after: always;
        }
        .page:last-child {
            page-break-after: auto;
        }

        .etiquette {
            width: 105mm;
            height: 37mm;
            padding: 3mm 5mm;
            display: flex;
            flex-direction: column;
            justify-content: center;
            gap: 2mm;
            overflow: hidden;
        }

        .top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 3mm;
        }
        .client {
            font-size: 14pt;
            font-weight: 700;
            color: #000;
            flex: 1;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .numero {
            font-size: 11pt;
            font-weight: 900;
            color: #000;
            white-space: nowrap;
        }

        .middle {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 3mm;
        }
        .produit {
            font-size: 12pt;
            color: #333;
            flex: 1;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .qte {
            font-size: 16pt;
            font-weight: 900;
            color: #000;
            white-space: nowrap;
        }

        .commentaire {
            font-size: 9pt;
            color: #b45309;
            font-style: italic;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .retrait {
            font-size: 8pt;
            color: #666;
            text-align: right;
        }
    </style>
</head>
<body>
    {% set allEtiquettes = [] %}
    {% for cmd in commandes %}
        {% for ligne in cmd.lignes %}
            {% set allEtiquettes = allEtiquettes|merge([{
                numero: cmd.numero,
                nomClient: cmd.nomClient,
                produit: ligne.produitNom,
                quantite: ligne.quantite,
                unite: ligne.unite,
                aPeser: ligne.aPeser,
                commentaire: ligne.commentaire,
                dateRetrait: cmd.dateRetrait,
                creneauRetrait: cmd.creneauRetrait
            }]) %}
        {% endfor %}
    {% endfor %}

    {% for page in allEtiquettes|batch(16) %}
    <div class="page">
        {% for etiq in page %}
        <div class="etiquette">
            <div class="top">
                <span class="client">{{ etiq.nomClient }}</span>
                <span class="numero">{{ etiq.numero }}</span>
            </div>
            <div class="middle">
                <span class="produit">{{ etiq.produit }}{{ etiq.aPeser ? ' ⚖️' : '' }}</span>
                <span class="qte">
                    {% if etiq.unite == 'kg' or etiq.unite == 'g' %}
                        {{ etiq.quantite }} {{ etiq.unite }}
                    {% else %}
                        × {{ etiq.quantite }}
                    {% endif %}
                </span>
            </div>
            {% if etiq.commentaire %}
            <div class="commentaire">→ {{ etiq.commentaire|length > 45 ? etiq.commentaire[:45] ~ '...' : etiq.commentaire }}</div>
            {% endif %}
            {% if etiq.dateRetrait %}
            <div class="retrait">{{ etiq.dateRetrait|date('d/m/Y') }}{% if etiq.creneauRetrait %} · {{ etiq.creneauRetrait }}{% endif %}</div>
            {% endif %}
        </div>
        {% endfor %}
        {# Remplir les cases vides #}
        {% for i in page|length..15 %}
        <div class="etiquette"></div>
        {% endfor %}
    </div>
    {% endfor %}
</body>
</html>
