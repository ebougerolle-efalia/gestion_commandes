<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Commande {{ commande.numero }}</title>
    <style>
        body {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 10pt;
            color: #333;
            margin: 0;
            padding: 0;
        }

        .header-table { width: 100%; margin-bottom: 15px; }
        .header-table td { vertical-align: top; padding: 0; }
        .company-name { font-size: 18pt; font-weight: bold; color: #1a1a1a; }
        .company-sub { font-size: 9pt; color: #666; }
        .cmd-label { font-size: 9pt; color: #666; text-align: right; }
        .cmd-numero { font-size: 16pt; font-weight: bold; text-align: right; }

        h1 { font-size: 20pt; font-weight: bold; color: #1a1a1a; text-align: center; letter-spacing: 2px; margin-bottom: 15px; }

        hr { border: none; border-top: 2px solid #333; margin-bottom: 15px; }

        .info-table { width: 100%; margin-bottom: 15px; font-size: 10pt; }
        .info-table td { padding: 3px 8px; vertical-align: top; }
        .info-table .label { font-weight: bold; color: #555; width: 120px; }

        .products-table { width: 100%; border-collapse: collapse; margin-bottom: 15px; }
        .products-table th {
            font-size: 8pt;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #666;
            padding: 6px 8px;
            border-bottom: 2px solid #333;
            text-align: left;
        }
        .products-table th.r { text-align: right; }
        .products-table th.c { text-align: center; }
        .products-table td {
            padding: 6px 8px;
            border-bottom: 1px solid #ddd;
            font-size: 9.5pt;
        }
        .products-table td.r { text-align: right; }
        .products-table td.c { text-align: center; }
        .products-table .note { font-size: 8pt; color: #b45309; font-style: italic; margin-top: 2px; }
        .products-table .peser { color: #b45309; }

        .totals-table { width: 50%; margin-left: auto; border-collapse: collapse; }
        .totals-table td { padding: 4px 8px; font-size: 10pt; }
        .totals-table td.r { text-align: right; font-weight: bold; }
        .totals-table tr.big td { font-size: 12pt; font-weight: bold; border-top: 2px solid #333; padding-top: 8px; }
        .totals-table tr.solde td { color: #059669; }
        .totals-table tr.reste td { color: #dc3545; }

        .footer { margin-top: 30px; font-size: 8pt; color: #999; text-align: center; }
    </style>
</head>
<body>

    <h1>FICHE COMMANDE</h1>

    <table class="header-table">
        <tr>
            <td>
                <div class="company-name">Pierrick Bougerolle</div>
                <div class="company-sub">Charcutier - Traiteur</div>
            </td>
            <td>
                <div class="cmd-label">Commande n°</div>
                <div class="cmd-numero">{{ commande.numero }}</div>
                {% if commande.numeroDevis %}
                <div style="font-size:9pt; color:#059669; text-align:right; margin-top:4px;">Devis {{ commande.numeroDevis }}</div>
                {% endif %}
            </td>
        </tr>
    </table>

    <hr>

    <table class="info-table">
        <tr>
            <td style="width:50%; vertical-align:top;">
                <table>
                    <tr><td class="label">Client</td><td>{{ commande.nomClient }}</td></tr>
                    <tr><td class="label">Téléphone</td><td>{{ commande.telephone }}</td></tr>
                </table>
            </td>
            <td style="width:50%; vertical-align:top;">
                <table>
                    {% if commande.dateRetrait %}
                    <tr><td class="label">Date retrait</td><td>{{ commande.dateRetrait|date('d/m/Y') }}{% if commande.creneauRetrait %} — {{ commande.creneauRetrait }}{% endif %}</td></tr>
                    {% endif %}
                    {% if commande.commentaire %}
                    <tr><td class="label">Commentaire</td><td style="color:#b45309; font-style:italic;">{{ commande.commentaire }}</td></tr>
                    {% endif %}
                </table>
            </td>
        </tr>
    </table>

    <table class="products-table">
        <thead>
            <tr>
                <th>Produit</th>
                <th class="c" style="width:70px;">Quantité</th>
                <th class="r" style="width:80px;">P.U.</th>
                <th class="r" style="width:80px;">Montant</th>
            </tr>
        </thead>
        <tbody>
            {% for ligne in commande.lignes %}
            <tr>
                <td>
                    {{ ligne.produitNom }}
                    {% if ligne.aPeser %}<span class="peser"> ⚖️</span>{% endif %}
                    {% if ligne.commentaire %}<div class="note">→ {{ ligne.commentaire }}</div>{% endif %}
                </td>
                <td class="c">{{ ligne.quantite }} {{ ligne.unite }}</td>
                <td class="r">{{ ligne.prixUnitaire|number_format(2, ',', ' ') }} €</td>
                <td class="r">
                    {% if ligne.aPeser and ligne.montantPese > 0 %}
                        {{ ligne.montantPese|number_format(2, ',', ' ') }} €
                    {% elseif ligne.aPeser %}
                        <span class="peser">À peser</span>
                    {% else %}
                        {{ (ligne.quantite * ligne.prixUnitaire)|number_format(2, ',', ' ') }} €
                    {% endif %}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <table class="totals-table">
        <tr class="big"><td>Total</td><td class="r">{{ commande.total|number_format(2, ',', ' ') }} €</td></tr>
        {% if commande.acompte > 0 %}
        <tr><td>Acompte</td><td class="r">- {{ commande.acompte|number_format(2, ',', ' ') }} €</td></tr>
        {% endif %}
        {% if commande.reste > 0 %}
        <tr class="reste"><td>Reste à payer</td><td class="r">{{ commande.reste|number_format(2, ',', ' ') }} €</td></tr>
        {% else %}
        <tr class="solde"><td>Soldé</td><td class="r">✓</td></tr>
        {% endif %}
    </table>

    <div class="footer">
        Généré le {{ 'now'|date('d/m/Y à H:i') }} — Pierrick Bougerolle, Charcutier-Traiteur
    </div>

</body>
</html>
