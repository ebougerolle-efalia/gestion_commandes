{% extends 'base.html.twig' %}
{% block title %}Sauvegarde{% endblock %}
{% block page_title %}Sauvegarde / Restauration{% endblock %}

{% block body %}
<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
    {# Export #}
    <div class="rounded-2xl border border-gray-200 bg-white">
        <div class="px-6 py-4 border-b border-gray-100 flex items-center gap-2"><div class="w-2 h-2 rounded-full bg-green-500"></div><h3 class="font-semibold text-[15px] text-[#1c2434]">Sauvegarder</h3></div>
        <div class="p-6">
            <p class="text-sm text-gray-500 mb-5">Exporte toutes les données (cartes, catégories, produits, commandes) dans un fichier JSON.</p>
            <a href="{{ path('app_backup_export') }}" class="inline-flex items-center gap-2 rounded-lg bg-green-500 hover:bg-green-600 px-6 py-3 text-sm font-medium text-white transition-colors">
                <i class="fas fa-download text-[12px]"></i> Télécharger la sauvegarde
            </a>
        </div>
    </div>

    {# Import #}
    <div class="rounded-2xl border border-gray-200 bg-white">
        <div class="px-6 py-4 border-b border-gray-100 flex items-center gap-2"><div class="w-2 h-2 rounded-full bg-amber-500"></div><h3 class="font-semibold text-[15px] text-[#1c2434]">Restaurer</h3></div>
        <div class="p-6">
            <div class="rounded-xl bg-amber-50 border border-amber-200 px-4 py-3 text-sm text-amber-700 mb-5 flex items-center gap-2">
                <i class="fas fa-exclamation-triangle text-amber-500"></i>
                La restauration <strong>remplace</strong> toutes les données.
            </div>
            <form method="post" action="{{ path('app_backup_import') }}" enctype="multipart/form-data" onsubmit="return confirm('Restaurer ? Toutes les données actuelles seront remplacées.')">
                <label class="block mb-4">
                    <span class="block text-sm font-medium text-gray-600 mb-1.5">Fichier .json</span>
                    <input type="file" name="backup_file" accept=".json" required class="block w-full text-sm text-gray-500 file:mr-4 file:py-2.5 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-blue-50 file:text-blue-600 hover:file:bg-blue-100 file:cursor-pointer cursor-pointer border border-gray-200 rounded-lg">
                </label>
                <button type="submit" class="inline-flex items-center gap-2 rounded-lg bg-amber-500 hover:bg-amber-600 px-5 py-2.5 text-sm font-medium text-white transition-colors">
                    <i class="fas fa-upload text-[12px]"></i> Restaurer
                </button>
            </form>
        </div>
    </div>
</div>

{# Current data #}
<div class="rounded-2xl border border-gray-200 bg-white">
    <div class="px-6 py-4 border-b border-gray-100"><h3 class="font-semibold text-[15px] text-[#1c2434]"><i class="fas fa-info-circle mr-2 text-gray-400 text-sm"></i>Données actuelles</h3></div>
    <div class="p-6">
        <div class="flex flex-wrap gap-4">
            {% for c in cartes %}
            <div class="flex items-center gap-3 rounded-xl bg-gray-50 border border-gray-100 px-4 py-3">
                <span class="inline-flex items-center rounded-lg bg-blue-500/10 px-2.5 py-1 text-xs font-semibold text-blue-600">{{ c.nom }}</span>
                <span class="text-xs text-gray-500">{{ c.categories|length }} cat. · {{ c.produits|length }} prod. · {{ c.commandes|length }} cmd.</span>
            </div>
            {% endfor %}
        </div>
        <p class="text-xs text-gray-400 mt-4">Compatible avec les backups de l'ancienne version Node.js (format v2.0).</p>
    </div>
</div>
{% endblock %}
