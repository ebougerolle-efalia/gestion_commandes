{% extends 'base.html.twig' %}
{% block title %}Utilisateurs{% endblock %}
{% block page_title %}Utilisateurs{% endblock %}
{% block page_subtitle %}Administration{% endblock %}
{% block page_actions %}
<button onclick="document.getElementById('addModal').classList.remove('hidden');document.getElementById('addModal').classList.add('flex')" class="inline-flex items-center gap-2 rounded-lg bg-blue-500 hover:bg-blue-600 px-4 py-2.5 text-sm font-medium text-white transition-colors">
    <i class="fas fa-plus text-[11px]"></i> Ajouter
</button>
{% endblock %}

{% block body %}
<div class="rounded-2xl border border-gray-200 bg-white">
    <table class="w-full text-sm">
        <thead>
            <tr class="border-b border-gray-100">
                <th class="py-3 px-5 text-left text-xs font-medium uppercase tracking-wider text-gray-400">Identifiant</th>
                <th class="py-3 px-3 text-center text-xs font-medium uppercase tracking-wider text-gray-400">Rôle</th>
                <th class="py-3 px-3 text-center text-xs font-medium uppercase tracking-wider text-gray-400">Statut</th>
                <th class="py-3 px-3 text-center text-xs font-medium uppercase tracking-wider text-gray-400">Créé le</th>
                <th class="py-3 px-5 text-center text-xs font-medium uppercase tracking-wider text-gray-400">Actions</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-50">
            {% for u in users %}
            <tr class="hover:bg-gray-50/50 {{ not u.active ? 'opacity-50' }}">
                <td class="py-3 px-5 font-medium text-gray-700">
                    {{ u.username }}
                    {% if u.id == app.user.id %}<span class="ml-1 text-[10px] text-blue-500">(vous)</span>{% endif %}
                </td>
                <td class="py-3 px-3 text-center">
                    <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-[11px] font-medium {{ u.role == 'admin' ? 'bg-purple-50 text-purple-600' : 'bg-gray-100 text-gray-500' }}">{{ u.role }}</span>
                </td>
                <td class="py-3 px-3 text-center">
                    {% if u.active %}
                        <span class="inline-flex items-center rounded-full bg-green-50 px-2 py-0.5 text-[11px] font-medium text-green-600">Actif</span>
                    {% else %}
                        <span class="inline-flex items-center rounded-full bg-red-50 px-2 py-0.5 text-[11px] font-medium text-red-600">Inactif</span>
                    {% endif %}
                </td>
                <td class="py-3 px-3 text-center text-gray-400 text-xs">{{ u.createdAt ? u.createdAt|date('d/m/Y') : '—' }}</td>
                <td class="py-3 px-5 text-center">
                    <div class="inline-flex items-center gap-1">
                        {# Edit modal trigger #}
                        <button onclick="openEdit({{ u.id }}, '{{ u.username }}', '{{ u.role }}', {{ u.active ? 'true' : 'false' }})"
                            class="w-8 h-8 inline-flex items-center justify-center rounded-lg text-gray-400 hover:text-blue-500 hover:bg-blue-50 transition-colors" title="Modifier">
                            <i class="fas fa-pencil-alt text-xs"></i>
                        </button>
                        {% if u.id != app.user.id %}
                        <form method="post" action="{{ path('app_user_delete', {id: u.id}) }}" onsubmit="return confirm('Supprimer « {{ u.username }} » ?')">
                            <button class="w-8 h-8 inline-flex items-center justify-center rounded-lg text-gray-400 hover:text-red-500 hover:bg-red-50 transition-colors" title="Supprimer">
                                <i class="fas fa-trash text-xs"></i>
                            </button>
                        </form>
                        {% endif %}
                    </div>
                </td>
            </tr>
            {% else %}
            <tr><td colspan="5" class="py-12 text-center text-gray-400">Aucun utilisateur</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{# ===== Modal Création ===== #}
<div id="addModal" class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/50" onclick="if(event.target===this){this.classList.add('hidden');this.classList.remove('flex')}">
<form method="post" action="{{ path('app_user_create') }}" class="bg-white rounded-2xl shadow-xl w-full max-w-sm mx-4">
    <div class="px-6 py-4 border-b border-gray-100"><h3 class="font-semibold text-[#1c2434]"><i class="fas fa-plus text-blue-500 mr-2 text-sm"></i>Nouvel utilisateur</h3></div>
    <div class="p-6 space-y-4">
        <div>
            <label class="block text-sm font-medium text-gray-600 mb-1.5">Identifiant *</label>
            <input type="text" name="username" required minlength="3" class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-500/20">
        </div>
        <div>
            <label class="block text-sm font-medium text-gray-600 mb-1.5">Mot de passe * (min 6)</label>
            <input type="password" name="password" required minlength="6" class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-500/20">
        </div>
        <div>
            <label class="block text-sm font-medium text-gray-600 mb-1.5">Rôle</label>
            <select name="role" class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm outline-none focus:border-blue-400 bg-white">
                <option value="user" selected>Utilisateur</option>
                <option value="admin">Administrateur</option>
            </select>
        </div>
    </div>
    <div class="px-6 py-4 border-t border-gray-100 flex justify-end gap-3">
        <button type="button" onclick="this.closest('.fixed').classList.add('hidden');this.closest('.fixed').classList.remove('flex')" class="rounded-lg border border-gray-200 px-4 py-2 text-sm text-gray-600 hover:bg-gray-50">Annuler</button>
        <button type="submit" class="rounded-lg bg-blue-500 hover:bg-blue-600 px-5 py-2 text-sm font-medium text-white">Créer</button>
    </div>
</form>
</div>

{# ===== Modal Modification ===== #}
<div id="editModal" class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/50" onclick="if(event.target===this){this.classList.add('hidden');this.classList.remove('flex')}">
<form id="editForm" method="post" class="bg-white rounded-2xl shadow-xl w-full max-w-sm mx-4">
    <div class="px-6 py-4 border-b border-gray-100"><h3 class="font-semibold text-[#1c2434]"><i class="fas fa-pencil-alt text-blue-500 mr-2 text-sm"></i>Modifier <span id="editUsername" class="text-blue-600"></span></h3></div>
    <div class="p-6 space-y-4">
        <div>
            <label class="block text-sm font-medium text-gray-600 mb-1.5">Rôle</label>
            <select name="role" id="editRole" class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm outline-none focus:border-blue-400 bg-white">
                <option value="user">Utilisateur</option>
                <option value="admin">Administrateur</option>
            </select>
        </div>
        <div>
            <label class="flex items-center gap-2 text-sm font-medium text-gray-600">
                <input type="checkbox" name="is_active" id="editActive" class="rounded border-gray-300 text-blue-500 focus:ring-blue-500/20">
                Actif
            </label>
        </div>
        <hr class="border-gray-100">
        <div>
            <label class="block text-sm font-medium text-gray-600 mb-1.5">Nouveau mot de passe <span class="text-gray-400 font-normal">(laisser vide = inchangé)</span></label>
            <input type="password" name="new_password" minlength="6" class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-500/20" placeholder="••••••">
        </div>
    </div>
    <div class="px-6 py-4 border-t border-gray-100 flex justify-end gap-3">
        <button type="button" onclick="this.closest('.fixed').classList.add('hidden');this.closest('.fixed').classList.remove('flex')" class="rounded-lg border border-gray-200 px-4 py-2 text-sm text-gray-600 hover:bg-gray-50">Annuler</button>
        <button type="submit" class="rounded-lg bg-blue-500 hover:bg-blue-600 px-5 py-2 text-sm font-medium text-white">Enregistrer</button>
    </div>
</form>
</div>
{% endblock %}

{% block javascripts %}
<script>
function openEdit(id, username, role, active) {
    document.getElementById('editForm').action = '/admin/utilisateurs/' + id + '/modifier';
    document.getElementById('editUsername').textContent = username;
    document.getElementById('editRole').value = role;
    document.getElementById('editActive').checked = active;
    const m = document.getElementById('editModal');
    m.classList.remove('hidden');
    m.classList.add('flex');
}
</script>
{% endblock %}
