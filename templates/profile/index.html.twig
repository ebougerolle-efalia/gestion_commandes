{% extends 'base.html.twig' %}
{% block title %}Mon profil{% endblock %}
{% block page_title %}Mon profil{% endblock %}
{% block page_subtitle %}{{ app.user.username }} · {{ app.user.role }}{% endblock %}

{% block body %}
<div class="max-w-lg">
    {# Infos compte #}
    <div class="rounded-2xl border border-gray-200 bg-white mb-6">
        <div class="px-6 py-4 border-b border-gray-100 flex items-center gap-2">
            <div class="w-2 h-2 rounded-full bg-blue-500"></div>
            <h3 class="font-semibold text-[15px] text-[#1c2434]">Informations du compte</h3>
        </div>
        <div class="p-6 space-y-3">
            <div class="flex justify-between items-center">
                <span class="text-sm text-gray-500">Identifiant</span>
                <span class="text-sm font-medium text-gray-900">{{ app.user.username }}</span>
            </div>
            <div class="flex justify-between items-center">
                <span class="text-sm text-gray-500">Rôle</span>
                <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-[11px] font-medium {{ app.user.role == 'admin' ? 'bg-purple-50 text-purple-600' : 'bg-gray-100 text-gray-500' }}">{{ app.user.role }}</span>
            </div>
            <div class="flex justify-between items-center">
                <span class="text-sm text-gray-500">Créé le</span>
                <span class="text-sm text-gray-700">{{ app.user.createdAt ? app.user.createdAt|date('d/m/Y') : '—' }}</span>
            </div>
        </div>
    </div>

    {# Changement mot de passe #}
    <div class="rounded-2xl border border-gray-200 bg-white">
        <div class="px-6 py-4 border-b border-gray-100 flex items-center gap-2">
            <div class="w-2 h-2 rounded-full bg-amber-500"></div>
            <h3 class="font-semibold text-[15px] text-[#1c2434]">Changer le mot de passe</h3>
        </div>
        <form method="post" action="{{ path('app_profile_password') }}" class="p-6 space-y-4">
            <div>
                <label class="block text-sm font-medium text-gray-600 mb-1.5">Mot de passe actuel *</label>
                <input type="password" name="current_password" required
                       class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-500/20">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-600 mb-1.5">Nouveau mot de passe * <span class="text-gray-400 font-normal">(min 6 caractères)</span></label>
                <input type="password" name="new_password" required minlength="6"
                       class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-500/20">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-600 mb-1.5">Confirmer le nouveau mot de passe *</label>
                <input type="password" name="confirm_password" required minlength="6"
                       class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-500/20">
            </div>
            <button type="submit" class="w-full rounded-lg bg-blue-500 hover:bg-blue-600 px-5 py-2.5 text-sm font-medium text-white transition-colors">
                <i class="fas fa-lock text-[11px] mr-1"></i> Modifier le mot de passe
            </button>
        </form>
    </div>
</div>
{% endblock %}
