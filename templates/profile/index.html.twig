{% extends 'base.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block body %}
    <div class="page-card">
        <h1 style="margin-top: 0;">Mon profil</h1>

        <p><strong>Nom d'utilisateur :</strong> {{ app.user.username }}</p>

        {% if app.user.role is defined %}
            <p><strong>Rôle :</strong> {{ app.user.role }}</p>
        {% endif %}
    </div>
{% endblock %}