{% extends 'base.html.twig' %}
{% block title %}Statistiques — {{ carte.nom }}{% endblock %}
{% block page_title %}Statistiques{% endblock %}

{% block body %}
{# KPI info-boxes #}
<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-7">
    <div class="rounded-2xl border border-gray-200 bg-white p-5"><div class="flex items-center gap-3 mb-3"><div class="w-10 h-10 rounded-full bg-blue-500/10 flex items-center justify-center"><i class="fas fa-shopping-cart text-blue-500 text-sm"></i></div><span class="text-xs text-gray-400 uppercase tracking-wide">Commandes</span></div><p class="text-2xl font-bold text-[#1c2434]">{{ stats.totalCommandes }}</p></div>
    <div class="rounded-2xl border border-gray-200 bg-white p-5"><div class="flex items-center gap-3 mb-3"><div class="w-10 h-10 rounded-full bg-green-500/10 flex items-center justify-center"><i class="fas fa-euro-sign text-green-500 text-sm"></i></div><span class="text-xs text-gray-400 uppercase tracking-wide">CA</span></div><p class="text-2xl font-bold text-[#1c2434]">{{ stats.chiffreAffaires|number_format(2, ',', ' ') }} <span class="text-base font-normal text-gray-400">€</span></p></div>
    <div class="rounded-2xl border border-gray-200 bg-white p-5"><div class="flex items-center gap-3 mb-3"><div class="w-10 h-10 rounded-full bg-purple-500/10 flex items-center justify-center"><i class="fas fa-hand-holding-usd text-purple-500 text-sm"></i></div><span class="text-xs text-gray-400 uppercase tracking-wide">Acomptes</span></div><p class="text-2xl font-bold text-[#1c2434]">{{ stats.totalAcomptes|number_format(2, ',', ' ') }} <span class="text-base font-normal text-gray-400">€</span></p></div>
    <div class="rounded-2xl border border-gray-200 bg-white p-5"><div class="flex items-center gap-3 mb-3"><div class="w-10 h-10 rounded-full bg-amber-500/10 flex items-center justify-center"><i class="fas fa-clock text-amber-500 text-sm"></i></div><span class="text-xs text-gray-400 uppercase tracking-wide">Reste</span></div><p class="text-2xl font-bold text-[#1c2434]">{{ stats.resteAEncaisser|number_format(2, ',', ' ') }} <span class="text-base font-normal text-gray-400">€</span></p></div>
</div>

{% if stats.totalCommandes > 0 %}
<div class="grid grid-cols-1 lg:grid-cols-5 gap-6">
    {# Décompte produits #}
    <div class="lg:col-span-3 rounded-2xl border border-gray-200 bg-white">
        <div class="px-5 py-4 border-b border-gray-100"><h3 class="font-semibold text-[15px] text-[#1c2434]"><i class="fas fa-list-ol mr-2 text-gray-400 text-sm"></i>Décompte par produit</h3></div>
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead><tr class="border-b border-gray-100"><th class="py-3 px-5 text-left text-xs font-medium uppercase tracking-wider text-gray-400">Produit</th><th class="py-3 px-3 text-right text-xs font-medium uppercase tracking-wider text-gray-400">Quantité</th><th class="py-3 px-5 text-left text-xs font-medium uppercase tracking-wider text-gray-400">Unité</th></tr></thead>
                <tbody class="divide-y divide-gray-50">
                    {% for item in stats.decompte %}
                    <tr class="hover:bg-gray-50/50"><td class="py-2.5 px-5 text-gray-700">{{ item.produit_nom }}</td><td class="py-2.5 px-3 text-right font-semibold text-[#1c2434]">{{ item.quantite }}</td><td class="py-2.5 px-5 text-gray-400">{{ item.unite }}</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {# Colonne droite #}
    <div class="lg:col-span-2 space-y-6">
        {# Par date #}
        <div class="rounded-2xl border border-gray-200 bg-white">
            <div class="px-5 py-4 border-b border-gray-100"><h3 class="font-semibold text-[15px] text-[#1c2434]"><i class="fas fa-calendar-alt mr-2 text-gray-400 text-sm"></i>Par date de retrait</h3></div>
            <table class="w-full text-sm">
                <tbody class="divide-y divide-gray-50">
                    {% for row in statsParDate %}
                    <tr class="hover:bg-gray-50/50"><td class="py-2.5 px-5 text-gray-700">{{ row.date_retrait ? row.date_retrait|date('d/m/Y') : 'Non défini' }}</td><td class="py-2.5 px-3 text-center text-gray-500">{{ row.nb_commandes }} cmd.</td><td class="py-2.5 px-5 text-right font-semibold text-[#1c2434]">{{ row.total|number_format(2, ',', ' ') }} €</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {# Indicateurs #}
        <div class="rounded-2xl border border-gray-200 bg-white p-5 space-y-4">
            <h3 class="font-semibold text-[15px] text-[#1c2434]"><i class="fas fa-calculator mr-2 text-gray-400 text-sm"></i>Indicateurs</h3>
            <div class="flex justify-between items-center"><span class="text-sm text-gray-500">Panier moyen</span><span class="text-sm font-semibold text-[#1c2434]">{{ (stats.chiffreAffaires / stats.totalCommandes)|number_format(2, ',', ' ') }} €</span></div>
            <div class="flex justify-between items-center"><span class="text-sm text-gray-500">Taux d'acompte</span><span class="text-sm font-semibold text-[#1c2434]">{{ ((stats.totalAcomptes / stats.chiffreAffaires) * 100)|number_format(0) }}%</span></div>
            <div class="flex justify-between items-center"><span class="text-sm text-gray-500">Produits distincts</span><span class="text-sm font-semibold text-[#1c2434]">{{ stats.decompte|length }}</span></div>
        </div>
    </div>
</div>
{% else %}
<div class="text-center py-20"><i class="fas fa-chart-pie text-5xl text-gray-200 mb-4 block"></i><p class="text-gray-400">Aucune commande pour cette carte.</p></div>
{% endif %}
{% endblock %}
