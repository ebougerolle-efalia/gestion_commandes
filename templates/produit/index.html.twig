{% extends 'base.html.twig' %}
{% block title %}Produits — {{ carte.nom }}{% endblock %}
{% block page_title %}Produits <span class="ml-2 text-sm font-normal text-gray-400">({{ produits|length }})</span>{% endblock %}
{% block page_actions %}<button onclick="document.getElementById('addModal').classList.remove('hidden');document.getElementById('addModal').classList.add('flex')" class="inline-flex items-center gap-2 rounded-lg bg-blue-500 hover:bg-blue-600 px-4 py-2.5 text-sm font-medium text-white transition-colors"><i class="fas fa-plus text-[11px]"></i> Ajouter</button>{% endblock %}

{% block body %}
<div class="rounded-2xl border border-gray-200 bg-white">
    {# Header avec per-page + recherche #}
    <div class="px-5 py-4 border-b border-gray-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex items-center gap-3">
            <label class="text-sm text-gray-500">Afficher</label>
            <select id="perPage" class="rounded-lg border border-gray-200 px-3 py-1.5 text-sm bg-white outline-none focus:border-blue-400">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="15">15</option>
                <option value="25">25</option>
                <option value="50">50</option>
            </select>
            <label class="text-sm text-gray-500">produits</label>
        </div>
        <div class="relative">
            <input type="text" id="searchProduit" placeholder="Rechercher…" class="w-60 pl-9 pr-3 py-2 rounded-lg border border-gray-200 text-sm outline-none focus:border-blue-400 bg-gray-50 placeholder-gray-400">
            <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs"></i>
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-sm" id="tableProduits">
            <thead>
                <tr class="border-b border-gray-100">
                    <th class="py-3 px-5 text-left text-xs font-medium uppercase tracking-wider text-gray-400">Nom</th>
                    <th class="py-3 px-3 text-left text-xs font-medium uppercase tracking-wider text-gray-400">Catégorie</th>
                    <th class="py-3 px-3 text-right text-xs font-medium uppercase tracking-wider text-gray-400">Prix</th>
                    <th class="py-3 px-3 text-center text-xs font-medium uppercase tracking-wider text-gray-400">Unité</th>
                    <th class="py-3 px-3 text-center text-xs font-medium uppercase tracking-wider text-gray-400">Peser</th>
                    <th class="py-3 px-3 text-center text-xs font-medium uppercase tracking-wider text-gray-400">Actif</th>
                    <th class="py-3 px-5 text-center text-xs font-medium uppercase tracking-wider text-gray-400" style="min-width:100px">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-50">
                {% for p in produits %}
                <tr class="produit-row hover:bg-gray-50/50 transition-colors {{ not p.actif ? 'opacity-50' }}" data-search="{{ p.nom|lower }} {{ p.categorie ? p.categorie.nom|lower : '' }}">
                    <td class="py-3 px-5 font-medium text-gray-700">{{ p.nom }}</td>
                    <td class="py-3 px-3 text-gray-500">{{ p.categorie ? p.categorie.nom : '—' }}</td>
                    <td class="py-3 px-3 text-right font-semibold text-gray-700">{{ p.prix|number_format(2, ',', ' ') }} €</td>
                    <td class="py-3 px-3 text-center text-gray-500">{{ p.unite }}</td>
                    <td class="py-3 px-3 text-center">{% if p.aPeser %}<span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-amber-50"><i class="fas fa-balance-scale text-amber-500 text-[10px]"></i></span>{% endif %}</td>
                    <td class="py-3 px-3 text-center">{% if p.actif %}<span class="inline-flex items-center rounded-full bg-green-50 px-2 py-0.5 text-[11px] font-medium text-green-600">Actif</span>{% else %}<span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-[11px] font-medium text-gray-400">Inactif</span>{% endif %}</td>
                    <td class="py-3 px-5 text-center">
                        <div class="inline-flex items-center gap-1">
                            <button onclick="editProduit({{ p.id }}, {{ p.nom|json_encode }}, {{ p.prix }}, '{{ p.unite }}', {{ p.aPeser?'true':'false' }}, {{ p.actif?'true':'false' }}, {{ p.categorie?p.categorie.id:'null' }})" class="w-8 h-8 inline-flex items-center justify-center rounded-lg text-gray-400 hover:text-blue-500 hover:bg-blue-50 transition-colors"><i class="fas fa-pencil-alt text-xs"></i></button>
                            <form method="post" action="{{ path('app_produit_delete', {carteId: carte.id, id: p.id}) }}" class="inline" onsubmit="return confirm('Supprimer ?')"><button class="w-8 h-8 inline-flex items-center justify-center rounded-lg text-gray-400 hover:text-red-500 hover:bg-red-50 transition-colors"><i class="fas fa-trash text-xs"></i></button></form>
                        </div>
                    </td>
                </tr>
                {% else %}<tr><td colspan="7" class="py-16 text-center text-gray-400 text-sm">Aucun produit.</td></tr>{% endfor %}
            </tbody>
        </table>
    </div>

    {# Pagination footer #}
    <div class="px-5 py-4 border-t border-gray-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <p class="text-sm text-gray-500" id="paginationInfo">—</p>
        <nav class="flex items-center gap-1" id="paginationNav"></nav>
    </div>
</div>

{# Add Modal #}
<div id="addModal" class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/50" onclick="if(event.target===this){this.classList.add('hidden');this.classList.remove('flex')}">
<form method="post" action="{{ path('app_produit_add', {carteId: carte.id}) }}" class="bg-white rounded-2xl shadow-xl w-full max-w-md mx-4">
    <div class="px-6 py-4 border-b border-gray-100"><h3 class="font-semibold text-[#1c2434]"><i class="fas fa-plus text-blue-500 mr-2 text-sm"></i>Nouveau produit</h3></div>
    <div class="p-6 space-y-4">
        <div><label class="block text-sm font-medium text-gray-600 mb-1.5">Nom *</label><input type="text" name="nom" required class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-500/20"></div>
        <div class="grid grid-cols-2 gap-4">
            <div><label class="block text-sm font-medium text-gray-600 mb-1.5">Prix *</label><input type="number" name="prix" step="0.01" min="0" required class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-500/20"></div>
            <div><label class="block text-sm font-medium text-gray-600 mb-1.5">Unité</label><select name="unite" class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm outline-none focus:border-blue-400 bg-white"><option value="pièce">pièce</option><option value="kg">kg</option><option value="grammes">grammes</option><option value="pers.">pers.</option></select></div>
        </div>
        <div><label class="block text-sm font-medium text-gray-600 mb-1.5">Catégorie</label><select name="categorie_id" class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm outline-none focus:border-blue-400 bg-white"><option value="">— Sans —</option>{% for cat in categories %}<option value="{{ cat.id }}">{{ cat.nom }}</option>{% endfor %}</select></div>
        <label class="flex items-center gap-2.5 cursor-pointer"><input type="checkbox" name="a_peser" value="1" class="w-4 h-4 rounded border-gray-300 text-blue-500 focus:ring-blue-500/20"><span class="text-sm text-gray-600">Produit à peser (prix au kg)</span></label>
    </div>
    <div class="px-6 py-4 border-t border-gray-100 flex justify-end gap-3"><button type="button" onclick="this.closest('.fixed').classList.add('hidden');this.closest('.fixed').classList.remove('flex')" class="rounded-lg border border-gray-200 px-4 py-2 text-sm text-gray-600 hover:bg-gray-50">Annuler</button><button type="submit" class="rounded-lg bg-blue-500 hover:bg-blue-600 px-5 py-2 text-sm font-medium text-white">Ajouter</button></div>
</form></div>

{# Edit Modal #}
<div id="editModal" class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/50" onclick="if(event.target===this){this.classList.add('hidden');this.classList.remove('flex')}">
<form id="editForm" method="post" class="bg-white rounded-2xl shadow-xl w-full max-w-md mx-4">
    <div class="px-6 py-4 border-b border-gray-100"><h3 class="font-semibold text-[#1c2434]"><i class="fas fa-pencil-alt text-blue-500 mr-2 text-sm"></i>Modifier</h3></div>
    <div class="p-6 space-y-4">
        <div><label class="block text-sm font-medium text-gray-600 mb-1.5">Nom *</label><input type="text" name="nom" id="editNom" required class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-500/20"></div>
        <div class="grid grid-cols-2 gap-4">
            <div><label class="block text-sm font-medium text-gray-600 mb-1.5">Prix *</label><input type="number" name="prix" id="editPrix" step="0.01" min="0" required class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm outline-none focus:border-blue-400 focus:ring-2 focus:ring-blue-500/20"></div>
            <div><label class="block text-sm font-medium text-gray-600 mb-1.5">Unité</label><select name="unite" id="editUnite" class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm outline-none focus:border-blue-400 bg-white"><option value="pièce">pièce</option><option value="kg">kg</option><option value="grammes">grammes</option><option value="pers.">pers.</option></select></div>
        </div>
        <div><label class="block text-sm font-medium text-gray-600 mb-1.5">Catégorie</label><select name="categorie_id" id="editCat" class="w-full rounded-lg border border-gray-200 px-4 py-2.5 text-sm outline-none focus:border-blue-400 bg-white"><option value="">— Sans —</option>{% for cat in categories %}<option value="{{ cat.id }}">{{ cat.nom }}</option>{% endfor %}</select></div>
        <label class="flex items-center gap-2.5 cursor-pointer"><input type="checkbox" name="a_peser" value="1" id="editAPeser" class="w-4 h-4 rounded border-gray-300 text-blue-500"><span class="text-sm text-gray-600">À peser</span></label>
        <label class="flex items-center gap-2.5 cursor-pointer"><input type="checkbox" name="actif" value="1" id="editActif" checked class="w-4 h-4 rounded border-gray-300 text-blue-500"><span class="text-sm text-gray-600">Actif</span></label>
    </div>
    <div class="px-6 py-4 border-t border-gray-100 flex justify-end gap-3"><button type="button" onclick="this.closest('.fixed').classList.add('hidden');this.closest('.fixed').classList.remove('flex')" class="rounded-lg border border-gray-200 px-4 py-2 text-sm text-gray-600 hover:bg-gray-50">Annuler</button><button type="submit" class="rounded-lg bg-blue-500 hover:bg-blue-600 px-5 py-2 text-sm font-medium text-white">Enregistrer</button></div>
</form></div>
{% endblock %}

{% block javascripts %}
<script>
function editProduit(id, nom, prix, unite, aPeser, actif, catId) {
    document.getElementById('editForm').action = `/produits/{{ carte.id }}/modifier/${id}`;
    document.getElementById('editNom').value = nom;
    document.getElementById('editPrix').value = prix;
    document.getElementById('editUnite').value = unite;
    document.getElementById('editAPeser').checked = aPeser;
    document.getElementById('editActif').checked = actif;
    document.getElementById('editCat').value = catId || '';
    const m = document.getElementById('editModal');
    m.classList.remove('hidden'); m.classList.add('flex');
}

// ===== PAGINATION =====
const allRows = [...document.querySelectorAll('.produit-row')];
let filtered = [...allRows];
let currentPage = 1;
let perPage = parseInt(document.getElementById('perPage').value);

function applyPagination() {
    allRows.forEach(r => r.style.display = 'none');
    const start = (currentPage - 1) * perPage;
    const end = Math.min(start + perPage, filtered.length);
    filtered.slice(start, end).forEach(r => r.style.display = '');

    const info = document.getElementById('paginationInfo');
    info.textContent = filtered.length === 0
        ? 'Aucun résultat'
        : `Affichage de ${start + 1} à ${end} sur ${filtered.length} produit${filtered.length > 1 ? 's' : ''}`;
    renderNav();
}

function renderNav() {
    const nav = document.getElementById('paginationNav');
    const totalPages = Math.max(1, Math.ceil(filtered.length / perPage));
    nav.innerHTML = '';
    const bc = 'w-9 h-9 flex items-center justify-center rounded-lg text-sm transition-colors';
    const ac = 'bg-blue-500 text-white font-medium';
    const nc = 'border border-gray-200 text-gray-600 hover:bg-gray-50';
    const dc = 'border border-gray-100 text-gray-300 cursor-not-allowed';

    const prev = Object.assign(document.createElement('button'), { type:'button', className:`${bc} ${currentPage===1?dc:nc}`, innerHTML:'<i class="fas fa-chevron-left text-[10px]"></i>', disabled:currentPage===1 });
    prev.onclick = () => { if(currentPage>1){currentPage--;applyPagination();} };
    nav.appendChild(prev);

    const maxV = 5;
    let sp = Math.max(1, currentPage - Math.floor(maxV/2));
    let ep = Math.min(totalPages, sp + maxV - 1);
    if(ep-sp<maxV-1) sp = Math.max(1, ep-maxV+1);
    if(sp>1){nav.appendChild(mkBtn(1));if(sp>2)nav.appendChild(mkDots());}
    for(let i=sp;i<=ep;i++) nav.appendChild(mkBtn(i));
    if(ep<totalPages){if(ep<totalPages-1)nav.appendChild(mkDots());nav.appendChild(mkBtn(totalPages));}

    const next = Object.assign(document.createElement('button'), { type:'button', className:`${bc} ${currentPage===totalPages?dc:nc}`, innerHTML:'<i class="fas fa-chevron-right text-[10px]"></i>', disabled:currentPage===totalPages });
    next.onclick = () => { if(currentPage<totalPages){currentPage++;applyPagination();} };
    nav.appendChild(next);

    function mkBtn(p){const b=Object.assign(document.createElement('button'),{type:'button',className:`${bc} ${p===currentPage?ac:nc}`,textContent:p});b.onclick=()=>{currentPage=p;applyPagination();};return b;}
    function mkDots(){const s=document.createElement('span');s.className='w-9 h-9 flex items-center justify-center text-gray-400 text-xs';s.textContent='…';return s;}
}

document.getElementById('searchProduit').addEventListener('input', function() {
    const q = this.value.toLowerCase().trim();
    filtered = q === '' ? [...allRows] : allRows.filter(r => r.dataset.search.includes(q));
    currentPage = 1;
    applyPagination();
});

document.getElementById('perPage').addEventListener('change', function() {
    perPage = parseInt(this.value);
    currentPage = 1;
    applyPagination();
});

applyPagination();
</script>
{% endblock %}
