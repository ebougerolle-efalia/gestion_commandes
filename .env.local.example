# Copier ce fichier en .env.local et adapter les valeurs
# NE PAS commiter .env.local dans Git !

APP_ENV=prod
APP_SECRET=CHANGEZ-MOI-avec-une-chaine-aleatoire-de-32-chars
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data/gestion_commandes.db"

# Secret pour le webhook GitHub (optionnel)
# Doit correspondre au secret configuré dans GitHub → Settings → Webhooks
# Payload URL : https://gestion-commandes.bougerolle.ovh/webhook.php
WEBHOOK_SECRET=mon-secret-webhook-tres-long
